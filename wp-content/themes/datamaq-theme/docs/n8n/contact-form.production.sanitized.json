[
  {
    "id": "wf_contact_form_production_sanitized",
    "name": "DataMaq Contact Form -> CRM",
    "active": false,
    "isArchived": false,
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "contact-form",
          "responseMode": "responseNode",
          "options": {
            "allowedOrigins": "https://www.datamaq.com.ar,https://datamaq.com.ar"
          }
        },
        "id": "webhook_contact",
        "name": "WebhookContact",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2.1,
        "position": [
          220,
          300
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict",
              "version": 2
            },
            "conditions": [
              {
                "id": "api-key-empty-or-match",
                "leftValue": "={{ !$env.DATAMAQ_WP_WEBHOOK_API_KEY || (($json.headers['x-api-key'] || $json.headers['X-API-KEY'] || '') === $env.DATAMAQ_WP_WEBHOOK_API_KEY) }}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "equals"
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "validate_api_key",
        "name": "Validate API Key",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          480,
          300
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict",
              "version": 2
            },
            "conditions": [
              {
                "id": "source-match",
                "leftValue": "={{ $json.body.source }}",
                "rightValue": "datamaq_wp_theme",
                "operator": {
                  "type": "string",
                  "operation": "equals"
                }
              },
              {
                "id": "name-present",
                "leftValue": "={{ !!String($json.body.data?.name || '').trim() }}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "equals"
                }
              },
              {
                "id": "email-or-phone-present",
                "leftValue": "={{ !!(String($json.body.data?.email || '').trim() || String($json.body.data?.phone || '').trim()) }}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "equals"
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "validate_payload",
        "name": "Validate Payload",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          740,
          220
        ]
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "lead_name",
                "name": "name",
                "value": "={{ String($json.body.data.name || '').trim() }}",
                "type": "string"
              },
              {
                "id": "lead_email",
                "name": "email",
                "value": "={{ String($json.body.data.email || '').trim() }}",
                "type": "string"
              },
              {
                "id": "lead_phone",
                "name": "phone",
                "value": "={{ String($json.body.data.phone || '').trim() }}",
                "type": "string"
              },
              {
                "id": "lead_company",
                "name": "company",
                "value": "={{ String($json.body.data.company || '').trim() }}",
                "type": "string"
              },
              {
                "id": "lead_message",
                "name": "message",
                "value": "={{ String($json.body.data.message || '').trim() }}",
                "type": "string"
              },
              {
                "id": "lead_channel",
                "name": "channel",
                "value": "={{ ['whatsapp', 'email'].includes($json.body.data.channel) ? $json.body.data.channel : 'email' }}",
                "type": "string"
              },
              {
                "id": "lead_source",
                "name": "source",
                "value": "={{ $json.body.source }}",
                "type": "string"
              },
              {
                "id": "lead_timestamp",
                "name": "timestamp",
                "value": "={{ $json.body.timestamp }}",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
        "id": "normalize_lead",
        "name": "Normalize Lead",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          1000,
          160
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://n8n.datamaq.com.ar/webhook/wf_suitecrm_webhook_create_contact/webhookcontact/suitecrm-create-contact",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "X-API-Key",
                "value": "={{ $env.N8N_SUITECRM_WEBHOOK_TOKEN }}"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ { first_name: $json.name || 'Lead', last_name: 'Web', email: $json.email || '', message: $json.message || '', preferred_contact_channel: $json.channel || 'email', custom_attributes: { phone: $json.phone || '', company: $json.company || '' } } }}",
          "options": {
            "timeout": 15000
          }
        },
        "id": "create_suitecrm_contact",
        "name": "Create SuiteCRM Contact",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1260,
          80
        ],
        "continueOnFail": true,
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ { status: 'accepted', detail: 'Submission queued' } }}",
          "options": {
            "responseCode": 202
          }
        },
        "id": "respond_accepted",
        "name": "Respond Accepted",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.4,
        "position": [
