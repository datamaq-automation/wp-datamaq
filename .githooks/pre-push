#!/bin/bash

# ==============================================================================
# DATA MAQ - CI LOCAL (PRE-PUSH HOOK)
# Versión: Observabilidad Premium
# ==============================================================================

# Colores para la terminal
GREEN='\033[0;32m'
RED='\033[0;31m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RESET='\033[0m'

echo -e "\n${CYAN}🚀 Iniciando validación técnica del proyecto...${RESET}"
echo -e "${CYAN}=================================================${RESET}"

# 1. Identificar archivos PHP relevantes
PHP_FILES=$(git ls-files | grep '\.php$')
TOTAL_FILES=$(echo "$PHP_FILES" | wc -l)

# ------------------------------------------------------------------------------
# NIVEL 1: PHP LINT (Sintaxis)
# ------------------------------------------------------------------------------
echo -e "\n${CYAN}🔍 [NIVEL 1] Verificando sintaxis en $TOTAL_FILES archivos PHP...${RESET}"

ERR_LINT=0
for FILE in $PHP_FILES; do
    if [ -f "$FILE" ]; then
        php -l "$FILE" > /dev/null 2>&1
        if [ $? -ne 0 ]; then
             echo -e "   ${RED}❌ Error:${RESET} $FILE"
             php -l "$FILE"
             ERR_LINT=$((ERR_LINT + 1))
        fi
    fi
done

if [ $ERR_LINT -gt 0 ]; then
    echo -e "\n${RED}🛑 PUSH ABORTADO: Se encontraron $ERR_LINT errores de sintaxis.${RESET}"
    exit 1
fi
echo -e "   ${GREEN}✅ Todos los archivos PHP tienen sintaxis válida.${RESET}"

# ------------------------------------------------------------------------------
# NIVEL 2: PHP CODE SNIFFER (Estándares WP)
# ------------------------------------------------------------------------------
echo -e "\n${CYAN}🎨 [NIVEL 2] Validando estándares de WordPress (WPCS)...${RESET}"

if [ -f "./vendor/bin/phpcs" ]; then
    # Ejecutar PHPCS con reporte de progreso y nombres de sniffs
    ./vendor/bin/phpcs --standard=phpcs.xml -s -n
    
    if [ $? -ne 0 ]; then
        echo -e "\n${RED}🛑 PUSH ABORTADO: Violaciones de calidad detectadas.${RESET}"
        echo -e "${YELLOW}💡 Tip: Podés usar './vendor/bin/phpcbf' para arreglar el formato automáticamente.${RESET}"
        exit 1
    fi
    echo -e "   ${GREEN}✅ El código cumple con los estándares de calidad definidos.${RESET}"
else
    echo -e "   ${YELLOW}⚠️  Aviso: PHPCS no encontrado en ./vendor/bin/. Saltando Nivel 2.${RESET}"
fi

# ------------------------------------------------------------------------------
# FINALIZACIÓN
# ------------------------------------------------------------------------------
echo -e "\n${GREEN}📤 ¡Todo en orden! Procediendo con el envío a GitHub...${RESET}\n"
exit 0
